# ============================================
# Configuração de Variáveis de Ambiente
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local (localmente) ou configure as variáveis no dashboard da Vercel (produção)
# 2. Preencha os valores abaixo com suas credenciais do Supabase
# 3. NUNCA commite o arquivo .env.local com valores reais no Git
#
# ============================================

# ============================================
# SUPABASE CONFIGURATION
# ============================================

# URL do seu projeto Supabase
# Obtenha em: https://supabase.com/dashboard/project/_/settings/general
# Formato: https://[seu-projeto-id].supabase.co
VITE_SUPABASE_URL=https://seu-projeto-id.supabase.co

# Chave pública (anon key) do Supabase
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
# Role: anon (pública, segura para uso no frontend)
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Nunca exponha a chave service_role no frontend nem use o prefixo VITE_.
# Operações administrativas devem usar SUPABASE_SERVICE_ROLE_KEY apenas nas Edge Functions.

# ============================================
# EXEMPLO DE VALORES (NÃO USE ESTES VALORES)
# ============================================
# VITE_SUPABASE_URL=https://eslfcjhnaojghzuswpgz.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# CONFIGURAÇÃO PARA VERCEL
# ============================================
# 
# No dashboard da Vercel, configure estas variáveis em:
# Project Settings > Environment Variables
#
# Adicione cada variável acima com seus valores reais.
# A Vercel automaticamente injetará essas variáveis durante o build.
